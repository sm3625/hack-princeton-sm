{"nodes": [{"id": "ideas_acoustic_forest_guardian", "label": "Idea: Acoustic Forest Guardian (edge AI against illegal logging and poaching)", "file_type": "document", "source_file": "ideas/acoustic-forest-guardian.md", "source_location": "L1-4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_acoustic_forest_guardian_signed_evidence", "label": "Signed on-device evidence (court-grade records)", "file_type": "rationale", "source_file": "ideas/acoustic-forest-guardian.md", "source_location": "L4, L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main differentiator: plain on-device chainsaw detection + LoRa alert is well-trodden prior art."}, {"id": "ideas_acoustic_forest_guardian_manual_logging_detection", "label": "Catching manual logging (axes, machetes, trucks, falling trees)", "file_type": "concept", "source_file": "ideas/acoustic-forest-guardian.md", "source_location": "L25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loggers who know about the sensors switch to axes and machetes or log at night."}, {"id": "ideas_acoustic_forest_guardian_tdoa_localization", "label": "Cross-node time-difference localization (stretch)", "file_type": "concept", "source_file": "ideas/acoustic-forest-guardian.md", "source_location": "L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs precise time sync (e.g. GPS time pulse); likely too much for a hackathon; listed as a SPEC non-goal."}, {"id": "ideas_acoustic_forest_guardian_biodiversity_bonus", "label": "Biodiversity call counting (bonus)", "file_type": "concept", "source_file": "ideas/acoustic-forest-guardian.md", "source_location": "L27", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ideas_acoustic_forest_guardian_tiered_architecture", "label": "Tiered architecture: sensor node / ranger station / opti