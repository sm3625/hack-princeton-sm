# Copy to .env (git-ignored) and fill in. Never commit .env.

# Which model the incident commander uses: ollama (default, free) | gemini (Vertex ADC) | haiku (comparison) | mock
LLM_MODE=ollama
OLLAMA_MODEL=qwen3:8b

# Only needed for LLM_MODE=haiku
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing (free tier)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Deployment profile: a file in deployments/ without .yaml (laguna_del_tigre_pilot | no_drone |
# well_resourced). Sets drones, ranger teams and limits. See docs/DEPLOYMENTS.md.
DEPLOYMENT=laguna_del_tigre_pilot

HOST=127.0.0.1
# Set a strong shared judge password for an HTTPS demo. Never commit the value.
STATION_JUDGE_PASSWORD=
# Exact HTTPS browser origins for that demo, comma separated.
STATION_HTTPS_ORIGINS=
PORT=8000

# Station event database and node keys (defaults: station.sqlite, keys/)
EVENTS_DB=
KEYS_DIR=
# Station UDP listener for live nodes ("off" disables)
LORA_UDP_HOST=127.0.0.1
LORA_UDP_PORT=9871

# Demo-only endpoints (POST /api/dev/tamper, used by the UI's tamper button). On for the local
# demo; leave unset or 0 anywhere the station is reachable by other people.
STATION_DEV=1
# Simulated radio loss between nodes and station (0..1). 0 keeps the demo deterministic.
LORA_LOSS=0
# Where nodes keep their clips ("SD card"); default node_data/. NODE_PIPELINE=off uses the
# simulator's stub detections instead of the node runtimes.
NODE_DATA_DIR=
NODE_PIPELINE=on

# Optional Photon 2.0 ranger bridge. Credentials alone NEVER enable it.
# `make photon` continuously polls; `make photon-preview` previews locally.
# Outbound messaging still requires --allow-sends N.
# Put the project-scoped key (pho_sk_...) only in ignored .env. See docs/PHOTON.md.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_RESOURCE_ID=
PHOTON_SPACE_ID=
PHOTON_AGENT_ID=
PHOTON_RANGER_ID=
PHOTON_STATION_URL=http://127.0.0.1:8000

# Edge sound detection connection. local runs the unchanged classifier in a separate process;
# arm64 requires a prebuilt Docker image. off uses the original station classifier.
EDGE_BACKEND=local
EDGE_PROFILE=pi-zero2

# Gemini via Vertex AI / ADC: set LLM_MODE=gemini after authenticating.
# gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_S=60

# Interactive demo: clear incidents, approvals and detections at every run boundary.
# Set to 0 only when intentionally retaining station history across scenarios.
DEMO_RESET_RUNS=1
