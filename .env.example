# Copy to .env (git-ignored) and fill in. Never commit .env.

# Which model the incident commander uses: ollama (default, free) | haiku | mock
LLM_MODE=ollama
OLLAMA_MODEL=qwen3:8b

# Only needed for LLM_MODE=haiku
ANTHROPIC_API_KEY=

# Optional: LangSmith tracing (free tier)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

HOST=127.0.0.1
PORT=8000
